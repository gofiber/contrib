{
  "uid": "fiber-go-runtime",
  "title": "Fiber / Go Runtime",
  "description": "Go runtime and process metrics registered by the gofiber/contrib prometheus middleware (DisableGoCollector and DisableProcessCollector turn them off).",
  "tags": [
    "fiber",
    "prometheus",
    "go"
  ],
  "editable": true,
  "graphTooltip": 1,
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "weekStart": "",
  "links": [
    {
      "title": "Fiber dashboards",
      "type": "dashboards",
      "tags": [
        "fiber"
      ],
      "asDropdown": false,
      "includeVars": true,
      "keepTime": true,
      "icon": "external link",
      "targetBlank": false,
      "tooltip": "",
      "url": ""
